# ── MongoDB ──────────────────────────────────────────────────────────────────
MONGO_URL=mongodb://localhost:27017
DB_NAME=saral_funding

# ── Azure Blob Storage ────────────────────────────────────────────────────────
# Full connection string from Azure Portal → Storage Account → Access keys
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=YOUR_ACCOUNT;AccountKey=YOUR_KEY;EndpointSuffix=core.windows.net
# Container name (will be auto-created if it does not exist)
AZURE_STORAGE_CONTAINER=saral-documents

# ── MSG91 (OTP login via SMS) ─────────────────────────────────────────────────
# Get these from control.msg91.com
MSG91_API_KEY=your_msg91_api_key
MSG91_TEMPLATE_ID=your_template_id
MSG91_SENDER_ID=YOURSD
MSG91_ENTITY_ID=your_entity_id

# OTP mode: true = mock 123456 (dev/testing), false = real MSG91 SMS (production)
USE_MOCK_OTP=true

# ── Setu Account Aggregator (optional) ───────────────────────────────────────
SETU_CLIENT_ID=
SETU_CLIENT_SECRET=
SETU_BASE_URL=https://fiu-uat.setu.co
