# ── MongoDB ───────────────────────────────────────────────────────────────────
MONGO_URL=mongodb://localhost:27017
DB_NAME=saral_funding

# ── Azure Blob Storage (document uploads) ─────────────────────────────────────
# Full connection string from Azure Portal → Storage Account → Access keys
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=YOUR_ACCOUNT;AccountKey=YOUR_KEY;EndpointSuffix=core.windows.net
# Container name (will be auto-created if it does not exist)
AZURE_STORAGE_CONTAINER=saral-documents

# ── MSG91 (OTP login via SMS, DLT compliant) ──────────────────────────────────
# Get these from control.msg91.com
MSG91_API_KEY=your_msg91_api_key
MSG91_TEMPLATE_ID=your_template_id
MSG91_SENDER_ID=YOURSD
MSG91_ENTITY_ID=your_entity_id
# OTP mode: true = mock OTP 123456 (dev/testing), false = real MSG91 SMS (production)
USE_MOCK_OTP=true

# ── OpenAI (AI scheme matching + advisor chat) ────────────────────────────────
# Get from platform.openai.com → API Keys
OPENAI_API_KEY=sk-...

# ── GoHighLevel CRM (optional — mock mode if not set) ────────────────────────
# Private Integration Token from GHL → Settings → Integrations → Private Integrations
GHL_API_KEY=pit-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Sub-account Location ID from GHL → Settings → Business Info
GHL_LOCATION_ID=your_location_id
# Name of the pipeline in GHL to sync leads to
GHL_PIPELINE_NAME=Saral Funding Prospects

# ── Setu Account Aggregator (optional) ───────────────────────────────────────
# Get from setu.co → Developer Console
SETU_CLIENT_ID=your_setu_client_id
SETU_CLIENT_SECRET=your_setu_client_secret
SETU_BASE_URL=https://fiu-uat.setu.co

# ── Auth & Security ───────────────────────────────────────────────────────────
# Random secret key for JWT signing (use: openssl rand -hex 32)
JWT_SECRET=your_random_32_char_secret_key
# The mobile number that gets promoted to super_admin on first login (digits only, no +91)
SUPER_ADMIN_MOBILE=9000000000
