{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "FastAPI Backend",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "uvicorn", "server:app", "--reload", "--host", "0.0.0.0", "--port", "8000"],
      "port": 8000,
      "cwd": "backend",
      "note": "Requires Python + pip install -r requirements.txt. Set MONGO_URL, DB_NAME, EMERGENT_LLM_KEY in backend/.env"
    },
    {
      "name": "Expo Web (Frontend)",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "web"],
      "port": 8081,
      "cwd": "frontend",
      "note": "Set EXPO_PUBLIC_BACKEND_URL=http://localhost:8000 in frontend/.env"
    }
  ]
}
