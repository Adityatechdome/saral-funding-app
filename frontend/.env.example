# ── Backend URL ───────────────────────────────────────────────────────────────
# For Android Emulator (Android Studio): use 10.0.2.2 (maps to your PC's localhost)
EXPO_PUBLIC_BACKEND_URL_EMULATOR=http://10.0.2.2:8000

# For Web / Browser (Chrome localhost): use localhost
EXPO_PUBLIC_BACKEND_URL_WEB=http://localhost:8000

# For Mock server (no Python/MongoDB needed, UI preview only):
EXPO_PUBLIC_BACKEND_URL_MOCK=http://localhost:3001

# ── Active URL (copy one of the above values here) ────────────────────────────
EXPO_PUBLIC_BACKEND_URL=http://localhost:8000
