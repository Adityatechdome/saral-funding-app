{
  "cli": {
    "version": ">= 10.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "env": {
          "EXPO_PUBLIC_BACKEND_URL": "https://saral-funding-app.onrender.com/api"
        }
      }
    },
    "preview": {
      "android": {
        "buildType": "apk",
        "env": {
          "EXPO_PUBLIC_BACKEND_URL": "https://saral-funding-app.onrender.com/api"
        }
      }
    },
    "production": {
      "android": {
        "buildType": "app-bundle",
        "env": {
          "EXPO_PUBLIC_BACKEND_URL": "https://saral-funding-app.onrender.com/api"
        }
      },
      "ios": {
        "env": {
          "EXPO_PUBLIC_BACKEND_URL": "https://saral-funding-app.onrender.com/api"
        }
      }
    }
  },
  "submit": {
    "production": {}
  }
}
